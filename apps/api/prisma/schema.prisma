// Mô hình dữ liệu theo SRS mục 6.2, kèm các bổ sung (đánh dấu "bổ sung") cần cho
// FR-05, FR-06, FR-08, FR-09, FR-18. Tiền luôn là số nguyên VND (NFR-04).
// Quy tắc: order_line, payment, bill_print, audit_log chỉ thêm, không sửa/xóa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COUNTER
  SHIFT_MANAGER
  OWNER
}

enum TabStatus {
  OPEN
  PAID
  MERGED // bổ sung: phiên nguồn sau khi gộp bàn
}

enum PrintStatus {
  PENDING
  PRINTED
  FAILED
}

enum LineType {
  NORMAL
  VOID
  DISCOUNT
}

enum AdjustReason {
  KHACH_DOI_Y
  BEP_HET_MON
  NHAP_NHAM
  MON_LOI
  KHAC
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum BillKind {
  PROVISIONAL
  FINAL
}

enum KegStatus {
  IN_STOCK
  TAPPED
  EMPTY
}

model Staff {
  id           Int      @id @default(autoincrement())
  name         String
  role         Role
  pinHash      String   @map("pin_hash")
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tabsOpened     Tab[]          @relation("TabOpenedBy")
  roundsCreated  OrderRound[]   @relation("RoundCreatedBy")
  linesCreated   OrderLine[]    @relation("LineCreatedBy")
  linesApproved  OrderLine[]    @relation("LineApprovedBy")
  discountsAsked BillDiscount[] @relation("BillDiscountCreatedBy")
  discountsOk    BillDiscount[] @relation("BillDiscountApprovedBy")
  payments       Payment[]
  billPrints     BillPrint[]
  shiftsOpened   Shift[]        @relation("ShiftOpenedBy")
  shiftsClosed   Shift[]        @relation("ShiftClosedBy")
  auditLogs      AuditLog[]
  pushSubs       PushSubscription[]

  @@map("staff")
}

model Area {
  id        Int           @id @default(autoincrement())
  name      String
  sortOrder Int           @default(0) @map("sort_order")
  tables    DiningTable[]

  @@map("area")
}

model DiningTable {
  id           Int     @id @default(autoincrement())
  areaId       Int     @map("area_id")
  code         String  @unique
  sortOrder    Int     @default(0) @map("sort_order")
  active       Boolean @default(true) // bổ sung: xóa mềm bàn đã có lịch sử
  /// bổ sung: phiên đang mở; @unique bảo đảm mỗi bàn tối đa 1 phiên mở (FR-03)
  currentTabId Int?    @unique @map("current_tab_id")

  area       Area @relation(fields: [areaId], references: [id])
  currentTab Tab? @relation("CurrentTab", fields: [currentTabId], references: [id])
  tabs       Tab[] @relation("TableTabs")

  @@map("dining_table")
}

model MenuGroup {
  id        Int        @id @default(autoincrement())
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]

  @@map("menu_group")
}

model MenuItem {
  id           Int     @id @default(autoincrement())
  groupId      Int     @map("group_id")
  name         String
  shortcut     String? @unique
  price        Int
  unit         String
  stationId    Int?    @map("station_id")
  beerVolumeMl Int?    @map("beer_volume_ml")
  defaultTapId Int?    @map("default_tap_id")
  available    Boolean @default(true)
  active       Boolean @default(true) // bổ sung: xóa mềm vì order_line tham chiếu
  sortOrder    Int     @default(0) @map("sort_order")
  /// Ảnh món: tên tệp trong thư mục uploads, phục vụ ở GET /uploads/:file
  imageFile    String? @map("image_file")

  group      MenuGroup        @relation(fields: [groupId], references: [id])
  station    PrintStation?    @relation(fields: [stationId], references: [id])
  defaultTap Tap?             @relation(fields: [defaultTapId], references: [id])
  lines      OrderLine[]
  hhPrices   HappyHourPrice[]

  @@map("menu_item")
}

model HappyHour {
  id          Int              @id @default(autoincrement())
  name        String
  /// 0 = Chủ nhật … 6 = Thứ bảy
  daysOfWeek  Int[]            @map("days_of_week")
  startMinute Int              @map("start_minute")
  endMinute   Int              @map("end_minute")
  active      Boolean          @default(true)
  prices      HappyHourPrice[]
  lines       OrderLine[]

  @@map("happy_hour")
}

model HappyHourPrice {
  id          Int @id @default(autoincrement())
  happyHourId Int @map("happy_hour_id")
  itemId      Int @map("item_id")
  price       Int

  happyHour HappyHour @relation(fields: [happyHourId], references: [id], onDelete: Cascade)
  item      MenuItem  @relation(fields: [itemId], references: [id])

  @@unique([happyHourId, itemId])
  @@map("happy_hour_price")
}

enum PrinterConnection {
  BROWSER // in bằng hộp thoại in của trình duyệt trên máy quầy (máy in mặc định)
  NETWORK // backend gửi thẳng tới máy in nhiệt có cổng mạng (ESC/POS qua TCP)
}

model PrintStation {
  id          Int               @id @default(autoincrement())
  name        String
  printerName String            @map("printer_name")
  connection  PrinterConnection @default(BROWSER)
  host        String? // IP máy in mạng, vd 192.168.1.50
  port        Int               @default(9100)
  items       MenuItem[]
  lines       OrderLine[]

  @@map("print_station")
}

model Tab {
  id           Int       @id @default(autoincrement())
  tableId      Int       @map("table_id")
  openedAt     DateTime  @default(now()) @map("opened_at")
  openedById   Int       @map("opened_by")
  guestCount   Int?      @map("guest_count")
  status       TabStatus @default(OPEN)
  closedAt     DateTime? @map("closed_at")
  mergedIntoId Int?      @map("merged_into_id") // bổ sung

  table         DiningTable    @relation("TableTabs", fields: [tableId], references: [id])
  currentOf     DiningTable?   @relation("CurrentTab")
  openedBy      Staff          @relation("TabOpenedBy", fields: [openedById], references: [id])
  mergedInto    Tab?           @relation("TabMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Tab[]          @relation("TabMerge")
  rounds        OrderRound[]
  billDiscounts BillDiscount[]
  payments      Payment[]
  billPrints    BillPrint[]

  @@index([status])
  @@index([closedAt])
  @@map("tab")
}

model OrderRound {
  id            Int         @id @default(autoincrement())
  tabId         Int         @map("tab_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  createdById   Int         @map("created_by")
  printedStatus PrintStatus @default(PENDING) @map("printed_status")
  note          String?

  tab       Tab         @relation(fields: [tabId], references: [id])
  createdBy Staff       @relation("RoundCreatedBy", fields: [createdById], references: [id])
  lines     OrderLine[]

  @@index([tabId])
  @@index([createdAt])
  @@map("order_round")
}

model OrderLine {
  id           Int           @id @default(autoincrement())
  roundId      Int           @map("round_id")
  itemId       Int           @map("item_id")
  itemName     String        @map("item_name") // bổ sung: chụp tên lúc gửi
  qty          Int
  unitPrice    Int           @map("unit_price")
  lineType     LineType      @default(NORMAL) @map("line_type")
  refLineId    Int?          @map("ref_line_id")
  reason       AdjustReason?
  reasonNote   String?       @map("reason_note")
  note         String? // ghi chú món cho bếp
  createdAt    DateTime      @default(now()) @map("created_at") // bổ sung (FR-06, FR-18)
  createdById  Int           @map("created_by") // bổ sung: người gửi / người yêu cầu hủy
  approvedById Int?          @map("approved_by")
  happyHourId  Int?          @map("happy_hour_id") // bổ sung
  stationId    Int?          @map("station_id") // bổ sung: chụp trạm in lúc gửi
  kegId        Int?          @map("keg_id") // bổ sung: keg đang gắn ở vòi lúc bán (FR-10)
  volumeMl     Int?          @map("volume_ml") // bổ sung: thể tích bia mỗi phần

  round       OrderRound    @relation(fields: [roundId], references: [id])
  item        MenuItem      @relation(fields: [itemId], references: [id])
  refLine     OrderLine?    @relation("LineAdjust", fields: [refLineId], references: [id])
  adjustments OrderLine[]   @relation("LineAdjust")
  createdBy   Staff         @relation("LineCreatedBy", fields: [createdById], references: [id])
  approvedBy  Staff?        @relation("LineApprovedBy", fields: [approvedById], references: [id])
  happyHour   HappyHour?    @relation(fields: [happyHourId], references: [id])
  station     PrintStation? @relation(fields: [stationId], references: [id])
  keg         Keg?          @relation(fields: [kegId], references: [id])

  @@index([roundId])
  @@index([refLineId])
  @@index([kegId])
  @@index([lineType, createdAt])
  @@map("order_line")
}

/// bổ sung: giảm giá cả hóa đơn (FR-08), xuất hiện trong nhật ký FR-18
model BillDiscount {
  id           Int          @id @default(autoincrement())
  tabId        Int          @map("tab_id")
  amount       Int // số âm
  percent      Int?
  reason       AdjustReason
  reasonNote   String?      @map("reason_note")
  createdAt    DateTime     @default(now()) @map("created_at")
  createdById  Int          @map("created_by")
  approvedById Int          @map("approved_by")

  tab        Tab   @relation(fields: [tabId], references: [id])
  createdBy  Staff @relation("BillDiscountCreatedBy", fields: [createdById], references: [id])
  approvedBy Staff @relation("BillDiscountApprovedBy", fields: [approvedById], references: [id])

  @@index([createdAt])
  @@map("bill_discount")
}

model Payment {
  id           Int           @id @default(autoincrement())
  tabId        Int           @map("tab_id")
  method       PaymentMethod
  amount       Int
  tendered     Int? // bổ sung: tiền khách đưa (tiền mặt)
  receivedById Int           @map("received_by")
  shiftId      Int?          @map("shift_id") // bổ sung (FR-09)
  createdAt    DateTime      @default(now()) @map("created_at")

  tab        Tab    @relation(fields: [tabId], references: [id])
  receivedBy Staff  @relation(fields: [receivedById], references: [id])
  shift      Shift? @relation(fields: [shiftId], references: [id])

  @@index([createdAt])
  @@index([shiftId])
  @@map("payment")
}

model BillPrint {
  id          Int      @id @default(autoincrement())
  tabId       Int      @map("tab_id")
  kind        BillKind
  printNo     Int      @map("print_no")
  printedAt   DateTime @default(now()) @map("printed_at")
  printedById Int      @map("printed_by")

  tab       Tab   @relation(fields: [tabId], references: [id])
  printedBy Staff @relation(fields: [printedById], references: [id])

  @@index([tabId])
  @@map("bill_print")
}

/// Ca dùng chung cho cả quán: tại một thời điểm chỉ có một ca mở.
model Shift {
  id           Int       @id @default(autoincrement())
  openedById   Int       @map("staff_id")
  openedAt     DateTime  @default(now()) @map("opened_at")
  openingCash  Int       @map("opening_cash")
  closedAt     DateTime? @map("closed_at")
  closedById   Int?      @map("closed_by")
  countedCash  Int?      @map("counted_cash")
  expectedCash Int?      @map("expected_cash")
  summary      Json?

  openedBy Staff     @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy Staff?    @relation("ShiftClosedBy", fields: [closedById], references: [id])
  payments Payment[]

  @@map("shift")
}

model Keg {
  id         Int       @id @default(autoincrement())
  beerName   String    @map("beer_name")
  capacityMl Int       @map("capacity_ml")
  cost       Int
  receivedAt DateTime  @map("received_at")
  status     KegStatus @default(IN_STOCK)
  tapId      Int?      @map("tap_id")
  tappedAt   DateTime? @map("tapped_at")
  emptiedAt  DateTime? @map("emptied_at")

  tap       Tap?        @relation("KegTap", fields: [tapId], references: [id])
  currentOn Tap?        @relation("CurrentKeg")
  lines     OrderLine[]

  @@index([status])
  @@map("keg")
}

model Tap {
  id           Int    @id @default(autoincrement())
  name         String
  sortOrder    Int    @default(0) @map("sort_order")
  currentKegId Int?   @unique @map("current_keg_id")

  currentKeg   Keg?       @relation("CurrentKeg", fields: [currentKegId], references: [id])
  kegHistory   Keg[]      @relation("KegTap")
  defaultItems MenuItem[]

  @@map("tap")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  payload   Json?    @map("payload_json")
  createdAt DateTime @default(now()) @map("created_at")

  actor Staff? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// FR-20: một thiết bị (trình duyệt/PWA) của chủ quán đăng ký nhận thông báo đẩy
model PushSubscription {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("push_subscription")
}

/// Cài đặt hệ thống dạng khóa–giá trị (vd cặp khóa VAPID tự sinh cho Web Push)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_setting")
}
