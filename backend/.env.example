# Sao chép file này thành .env là chạy được với CSDL chung của nhóm trên Neon.

# CSDL chung của nhóm trên Neon. Không chạy migrate / db seed lên CSDL này (seed xóa toàn bộ dữ liệu), việc đó do người phụ trách backend làm.
DATABASE_URL="postgresql://neondb_owner:npg_j64xCZpAKlDd@ep-icy-sun-aop4edsc.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# CSDL riêng cho npm test, cùng project Neon nhưng khác database (bị xóa sạch mỗi lần chạy test)
TEST_DATABASE_URL="postgresql://neondb_owner:npg_j64xCZpAKlDd@ep-icy-sun-aop4edsc.c-2.ap-southeast-1.aws.neon.tech/biahoi_test?sslmode=require&channel_binding=require"

# Chuỗi ngẫu nhiên dài để ký JWT
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# Địa chỉ frontend được phép gọi API (nhiều địa chỉ thì ngăn cách bằng dấu phẩy)
CORS_ORIGIN="http://localhost:5173"

# Cổng chạy backend
PORT=3000

# Tài khoản nhận chuyển khoản của quán (dùng tạo ảnh VietQR)
VIETQR_BANK="MB"
VIETQR_ACCOUNT="0123456789"
VIETQR_ACCOUNT_NAME="QUAN BIA HOI DEMO"
