# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Chuỗi kết nối PostgreSQL trên Neon (lấy ở Neon Console > Connect)
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# CSDL riêng cho npm test, cùng project Neon nhưng khác database (bị xóa sạch mỗi lần chạy test)
TEST_DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/biahoi_test?sslmode=require"

# Chuỗi ngẫu nhiên dài để ký JWT
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# Địa chỉ frontend được phép gọi API (nhiều địa chỉ thì ngăn cách bằng dấu phẩy)
CORS_ORIGIN="http://localhost:5173"

# Cổng chạy backend
PORT=3000

# Tài khoản nhận chuyển khoản của quán (dùng tạo ảnh VietQR)
VIETQR_BANK="MB"
VIETQR_ACCOUNT="0123456789"
VIETQR_ACCOUNT_NAME="QUAN BIA HOI DEMO"
